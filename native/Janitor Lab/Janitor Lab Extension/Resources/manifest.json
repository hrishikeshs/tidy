{
  "manifest_version": 3,
  "name": "Janitor Lab",
  "description": "Evidence-first Safari storage inspection and selective cleanup laboratory.",
  "version": "0.1.0",
  "icons": {
    "48": "images/icon-48.png",
    "96": "images/icon-96.png",
    "128": "images/icon-128.png",
    "256": "images/icon-256.png",
    "512": "images/icon-512.png"
  },
  "background": {
    "scripts": [
      "background/background.js"
    ],
    "persistent": false
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Inspect this site",
    "default_icon": "images/toolbar-icon.svg"
  },
  "permissions": [
    "activeTab",
    "cookies",
    "declarativeNetRequest",
    "scripting",
    "storage"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "janitor_lab_fixture_rules",
        "enabled": true,
        "path": "rules/fixture-rules.json"
      }
    ]
  }
}
