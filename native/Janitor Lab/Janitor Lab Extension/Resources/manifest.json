{
  "manifest_version": 3,
  "name": "Tidy",
  "description": "A local, all-sites maintenance dashboard for Safari.",
  "version": "0.4.0",
  "icons": {
    "48": "images/icon-48.png",
    "96": "images/icon-96.png",
    "128": "images/icon-128.png",
    "256": "images/icon-256.png",
    "512": "images/icon-512.png"
  },
  "background": {
    "scripts": [
      "shared/catalog.js",
      "background/background.js"
    ],
    "persistent": false
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Open Tidy",
    "default_icon": "images/toolbar-icon.svg"
  },
  "permissions": [
    "activeTab",
    "cookies",
    "declarativeNetRequest",
    "nativeMessaging",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "shared/catalog.js",
        "content/inspector.js",
        "content/observer.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "janitor_lab_fixture_rules",
        "enabled": true,
        "path": "rules/fixture-rules.json"
      }
    ]
  }
}
